{
  "name": "apex-racing-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:pyodide": "node scripts/copy-pyodide.mjs",
    "dev": "npm run prepare:pyodide && vite --host 0.0.0.0",
    "build": "npm run prepare:pyodide && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "test": "vitest run",
    "test:python": "cd python && python3 -m pytest",
    "test:e2e": "playwright test",
    "bench:physics": "node scripts/bench-physics.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "pyodide": "314.0.7",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.19.2",
    "@types/three": "0.170.0",
    "typescript": "~5.7.3",
    "vite": "^6.4.0",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
